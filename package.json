{
  "name": "romm2steamdeck-app",
  "productName": "RomM2SteamDeck",
  "version": "2.2.31",
  "description": "Desktop client for browsing and downloading from a RomM library",
  "main": "dist/main.js",
  "author": "Jason Walters",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.lifeisguid.romm2steamdeck",
    "productName": "RomM2SteamDeck",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/7zip/win-x64",
          "to": "7zip",
          "filter": [
            "7za.exe"
          ]
        },
        {
          "from": "vendor/7zip/License.txt",
          "to": "7zip/License.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RomM2SteamDeck"
    },
    "portable": {
      "artifactName": "RomM2SteamDeck-${version}-portable.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "RomM2SteamDeck.AppImage",
      "target": [
        "AppImage"
      ],
      "extraResources": [
        {
          "from": "vendor/7zip/linux-x64",
          "to": "7zip",
          "filter": [
            "7zz"
          ]
        },
        {
          "from": "vendor/7zip/License.txt",
          "to": "7zip/License.txt"
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "vendor/7zip/mac",
          "to": "7zip",
          "filter": [
            "7zz"
          ]
        },
        {
          "from": "vendor/7zip/License.txt",
          "to": "7zip/License.txt"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/unzipper": "^0.10.11",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "unzipper": "^0.12.5"
  }
}
